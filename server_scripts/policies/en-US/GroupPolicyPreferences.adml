        <checkBox refId="CSE_NOCHANGES" defaultChecked="true">Process even if the Group Policy objects have not changed</checkBox>
        <dropdownList refId="CSE_BACKGROUNDPRIORTYLEVEL" noSort="true" defaultItem="3">Background priority</dropdownList>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
